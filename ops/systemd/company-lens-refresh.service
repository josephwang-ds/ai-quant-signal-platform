[Unit]
Description=Refresh Company Lens evidence and rebuild static pages
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=company-lens
Group=company-lens
WorkingDirectory=/opt/company-lens
EnvironmentFile=/etc/company-lens.env
Environment="PATH=/opt/company-lens/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HOME=/opt/company-lens/data/vercel-home"
Environment="XDG_CACHE_HOME=/opt/company-lens/data/vercel-cache"
Environment="VERCEL_TELEMETRY_DISABLED=1"
ExecStart=/opt/company-lens/scripts/run_scheduled_refresh.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/company-lens

[Install]
WantedBy=multi-user.target
