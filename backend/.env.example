# Comma-separated browser origins for CORS (required on Render).
# Use origins only, without paths. Trailing slashes are normalized.
# Wildcards are rejected. Include the exact deployed Vercel origin.
# Production: https://your-app.vercel.app,https://www.your-domain.com
# Local defaults include localhost/127.0.0.1 on ports 3000 and 3001.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Postgres connection string for durable legacy backtest records.
# Use the Transaction Pooler URI from Supabase Connect.
# Do not commit real credentials.
SUPABASE_DB_URL=

# Render injects PORT automatically; local development can omit it.
# PORT=8000

# ---------------------------------------------------------------------------
# Public demo security & cost protection (single-instance portfolio demo)
# ---------------------------------------------------------------------------
# In-memory rate limiting / LLM concurrency apply to ONE web process only.
# They are not a distributed multi-replica exact limiter. Do not claim
# cluster-wide precision when running multiple Render instances.
#
# Request body hard cap (bytes). Oversized bodies return HTTP 413.
MAX_REQUEST_BODY_BYTES=1048576
#
# Sliding-window limits (requests per RATE_LIMIT_WINDOW_SECONDS).
# LLM/Agent (Copilot, Reviewer, Governance Agent) is strictest.
AGENT_RATE_LIMIT=10
EXPENSIVE_RATE_LIMIT=30
WRITE_RATE_LIMIT=20
READ_RATE_LIMIT=120
RATE_LIMIT_WINDOW_SECONDS=60
# Set false only for local stress debugging.
RATE_LIMIT_ENABLED=true
#
# Bounded LLM concurrency — excess calls fail with HTTP 503 (no infinite queue).
LLM_MAX_CONCURRENCY=2
#
# Explicit timeouts (seconds).
LLM_TIMEOUT_SECONDS=45
PROVIDER_FETCH_TIMEOUT_SECONDS=30
VALIDATION_TIMEOUT_SECONDS=120
#
# Trusted reverse-proxy peer IPs only. X-Forwarded-For / X-Real-IP are ignored
# unless the direct TCP peer is listed here. Never leave this as "*" .
# Example behind Render/nginx on a known hop: TRUSTED_PROXY_IPS=10.0.0.1
TRUSTED_PROXY_IPS=

# Research Copilot — backend-only OpenAI-compatible Chat Completions.
# Exactly one provider per deployment. No failover. Never use NEXT_PUBLIC_*.
#
# OpenAI example:
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# COPILOT_MODEL=gpt-4o-mini
#
# DeepSeek example:
# LLM_PROVIDER=deepseek
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# COPILOT_MODEL=deepseek-v4-flash
#
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_BASE_URL=
# COPILOT_MODEL=
#
# Deprecated temporary fallback (prefer LLM_API_KEY):
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Intelligence publishing layer (Phase 4.1 — research run registry)
# ---------------------------------------------------------------------------
# Filesystem root for immutable research-run manifests.
# Empty / unset → repository-local backend/outputs (created on demand).
# Example override: INTELLIGENCE_OUTPUT_DIR=/var/data/ai-quant/outputs
INTELLIGENCE_OUTPUT_DIR=
