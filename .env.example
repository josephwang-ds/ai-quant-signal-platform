# Copy this file to .env, fill only the providers you use, then run:
#   set -a; source .env; set +a
# Never commit the populated .env file.

COMPANY_LENS_LLM_PROVIDER=openai

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional Supabase evidence adapter. Prefer the current sb_secret_ backend key.
# It belongs only on the Vultr worker/backend. Never expose it to a Vercel
# frontend, browser JavaScript, or any public build artifact. Never commit a
# populated .env file.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service_role JWT fallback only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional model overrides
# COMPANY_LENS_OPENAI_MODEL=gpt-5.6-terra
# COMPANY_LENS_DEEPSEEK_MODEL=deepseek-v4-flash
# COMPANY_LENS_QWEN_MODEL=qwen3.8-max
# COMPANY_LENS_ANTHROPIC_MODEL=claude-sonnet-5
# COMPANY_LENS_GEMINI_MODEL=gemini-3.7-flash
